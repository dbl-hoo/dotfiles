
#located in /home/kirkham/.config/kirkham-dotfiles/
# save, git pull, then referesh
# ~/.zshrc (Linux)

# ---- Paths
export ZSH_PLUGIN_DIR="$HOME/.zsh/plugins"

# ---- History
HISTSIZE=10000
SAVEHIST=10000
HISTFILE="$HOME/.zsh_history"
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

# ---- Completion
autoload -U compinit && compinit

# ---- Plugins (safe sourcing)
# autosuggestions
if [[ -r "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
else
  print -P "%F{yellow}zsh-autosuggestions missing%f (expected in $ZSH_PLUGIN_DIR)"
fi

# syntax-highlighting (must be last-ish)
if [[ -r "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
else
  print -P "%F{yellow}zsh-syntax-highlighting missing%f (expected in $ZSH_PLUGIN_DIR)"
fi

# ---- Powerlevel10k
if [[ -r "$ZSH_PLUGIN_DIR/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "$ZSH_PLUGIN_DIR/powerlevel10k/powerlevel10k.zsh-theme"
  [[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
else
  print -P "%F{yellow}powerlevel10k missing%f (expected in $ZSH_PLUGIN_DIR)"
fi

# ---- Aliases
# NOTE: eza may not be installed yet; keep it optional.
alias ll='ls -lah'
command -v eza >/dev/null 2>&1 && alias ll='eza -lah --icons'

alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gps='git push'
alias gpl='git pull'
alias ff='fastfetch'
alias c='clear'

# Basic replacement for 'ls'
alias ls='eza --icons --group-directories-first'

# The 'long' view (replaces ll)
# Adds: file sizes, headers, and git status symbols
alias ll='eza -lahg --icons --git --group-directories-first'

# The 'all' view (includes hidden files)
alias la='eza -a --icons'

# Tree view
alias tree='eza --tree --icons'

# Replace cat with bat for better reading
alias cat='bat --paging=never'

# Use bat for viewing files with a pager (helpful for logs)
alias less='bat'

alias dcu='docker compose up -d'
alias dcd='docker compose down'
alias dcr='docker compose restart'
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dlogs='docker logs -f'
alias dstop='docker stop'
alias dstart='docker start'
# Remove stopped containers
alias dprune='docker container prune -f'

# Remove unused images
alias diprune='docker image prune -f'

# Remove unused volumes (be careful with this one)
alias dvprune='docker volume prune -f'

# Nuclear option — cleans containers, images, networks, build cache
alias dclean='docker system prune -af'

# See how much disk Docker is using
alias dsize='docker system df'

# ---- Run fastfetch on interactive shells only, and only if installed
if [[ $- == *i* ]] && command -v fastfetch >/dev/null 2>&1; then
  fastfetch
fi